{
  "schema": "robot-learning-lab.public-source-policy.v1",
  "note": "Since 2026-11-20 this repository is the public idle-builders/robot-learning-lab; every tracked file must match this policy (python3 infra/tools/public_source.py check, run by .githooks/pre-push and CI).",
  "include": [
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    ".gitignore",
    ".gitleaks.toml",
    ".env.example",
    "pyproject.toml",
    ".githooks/*",
    ".github/workflows/*.yml",
    ".agents/skills/*",
    ".claude/launch.json",
    ".claude/settings.json",
    ".codex/config.toml",
    "robot/*",
    "control/*",
    "infra/*",
    "docs/*"
  ],
  "exclude_parts": [
    ".git",
    ".cache",
    "__pycache__",
    "node_modules",
    "source",
    "sources",
    "source-files",
    "snapshot",
    "snapshots",
    "output",
    "outputs",
    "traces",
    "checkpoints",
    "vendor"
  ],
  "exclude_patterns": [
    "*/source-backup/*",
    "*/audits/*",
    "*/exports/*",
    "docs/learning materials/*",
    "docs/operations/*.journal.jsonl",
    "docs/operations/*infomaniak*.manifest.json",
    "infra/compute/runpod/account.json"
  ],
  "extensions": [
    ".py",
    ".md",
    ".json",
    ".jsonl",
    ".yaml",
    ".yml",
    ".toml",
    ".xml",
    ".csv",
    ".sh",
    ".txt",
    ".lock",
    ".c",
    ".h",
    ".ato",
    ".kicad_mod",
    ".kicad_sym",
    ".js",
    ".css",
    ".html",
    ".tf",
    ".hcl",
    ".svg",
    ".urdf",
    ".mjcf",
    ".ini",
    ".cfg",
    ".cjs",
    ".Dockerfile",
    ".cpp",
    ".srdf"
  ],
  "plain_names": [
    ".gitignore",
    ".env.example",
    "lab",
    "runpod-flash",
    "pre-push",
    "pre-commit",
    "post-commit",
    "post-merge",
    "CMakeLists.txt"
  ],
  "exact_assets": [
    "control/common/motions/ape_foot_transition.npz",
    "control/common/motions/ape_foot_transition_right_mirror.npz",
    "control/common/motions/ape_single_forward_step_left.npz",
    "control/common/motions/ape_single_forward_step_right.npz",
    "infra/dashboard/ui/body-map.png",
    "robot/shell/sketch/reference/sketch.png"
  ],
  "max_file_bytes": 2500000,
  "overlays": {}
}
