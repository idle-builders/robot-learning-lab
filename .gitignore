# Clean public checkout; its Git history is separate from the private lab.
/.public-upstream/

# Account-specific transport destination regenerated by Terraform apply.
/infra/compute/serverless/storage_config.py

# data/ is the local catalog: databases, storage run state, run and build records, the spend
# ledger and the catalog pointer. The repository is public, so none of it is in Git; it is backed
# up to the private bucket by infra/storage/catalog_backup.py.
/data/*

# Private records kept beside the docs: Runpod/Infomaniak transfer journals and manifests (they name
# the private bucket and its objects) and personal study notes.
/docs/operations/*.journal.jsonl
/docs/operations/*infomaniak*.manifest.json
/docs/learning materials/
# local catalog, ledgers and private archive config (backed up to the private bucket)
/data/
