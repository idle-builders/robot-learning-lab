.DS_Store
# Retained assets have verified private restore routes; local CAS copies can be evicted.
.artifact-store/

# Credentials and machine-specific archive configuration never belong in Git.
.env
.env.*
!.env.example
!.env.*.example
.credentials/
*.pem
*.key
/data/private-archive.json
/publication/audits/
/publication/exports/

# Caches, logs and scratch output
.cache/
# Local process records (reviews, receipts, locks, logs); see docs/operations/git-and-bookkeeping.md.
.bookkeeping/
.flash/
.ruff_cache/
tmp/
