# Optional private archive. The dashboard starts without these settings.
# Copy to .env and explicitly load with: set -a; . ./.env; set +a
ROBOTLAB_ARCHIVE_BUCKET=
ROBOTLAB_ARCHIVE_ENDPOINT=https://s3.pub2.infomaniak.cloud
ROBOTLAB_ARCHIVE_REGION=us-east-1
# Use an AWS profile or supply both credentials through your local environment.
# Never commit credentials, signed playback URLs, or a filled-in .env file.
