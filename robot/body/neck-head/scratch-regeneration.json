{
  "schema": "robot-learning-lab.scratch-regeneration.v1",
  "study": "robot/body/neck-head",
  "artifacts": "artifacts/robot/body/neck-head",
  "retained_native_evidence": [
    "*/assembly-with-full-shell.glb",
    "*/assembly-parts.json",
    "*/manifest.json",
    "*/connectors-4stage.step",
    "*/*_sleeves.step",
    "*/*_sleeves.npz",
    "*/renders/*.png",
    "parts/*.step",
    "parts/*.npz",
    "neck-head-topopt-fields.npz",
    "*.json",
    "renders/*.png"
  ],
  "disposable_derived_outputs_removed": [
    "parts/*.stl",
    "zbuffer_renderer_bin"
  ],
  "regeneration_commands": {
    "all_part_stls": ".venv/bin/python robot/body/neck-head/regenerate_derived.py --all-stls",
    "single_part_stl": ".venv/bin/python robot/body/neck-head/regenerate_derived.py --step <PATH_TO_STEP> --output <OUTPUT_STL>",
    "all_neck_head_glbs_and_renders": ".venv/bin/python robot/body/neck-head/package_and_render.py"
  }
}
