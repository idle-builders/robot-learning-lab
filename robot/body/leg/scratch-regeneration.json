{
  "schema": "robot-learning-lab.scratch-regeneration.v1",
  "study": "robot/body/leg",
  "artifacts": "artifacts/robot/body/leg",
  "retained_native_evidence": [
    "*/assembly-with-full-shell.glb",
    "*/parts.json",
    "*/bom.json",
    "*/cad-manifest.json",
    "*/connectors-bilateral.step",
    "*/lower-leg-connectors-bilateral.step",
    "*/parts/*.step",
    "shell_mounts_2screw/*.step",
    "shell_mounts_2screw/*.npz",
    "topopt/*.npz",
    "topopt/*-report.json",
    "fem-fields/*.npz",
    "*.json",
    "renders/*.png"
  ],
  "disposable_derived_outputs_removed": [
    "*/parts/*.stl",
    "*/complete-lower-body-with-actuators.glb",
    "*/lower-leg-mechanism-context.glb",
    "*/lower-leg-with-hard-shell.glb"
  ],
  "regeneration_commands": {
    "all_part_stls": ".venv/bin/python robot/body/leg/regenerate_derived.py --all-stls",
    "single_part_stl": ".venv/bin/python robot/body/leg/regenerate_derived.py --step <PATH_TO_STEP> --output <OUTPUT_STL>",
    "subset_lower_leg_glbs": ".venv/bin/python robot/body/leg/package_and_render.py",
    "subset_complete_leg_hip_glbs": ".venv/bin/python robot/body/leg/package_complete_leg_hip.py"
  }
}
